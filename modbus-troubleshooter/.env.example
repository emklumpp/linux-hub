# Copy this file to .env and adjust for your environment.
# docker-compose reads GRAFANA_PASSWORD from here; the troubleshooter
# container reads the rest via pydantic-settings.

# Application
APP_NAME=Modbus Troubleshooter
DEBUG=false
LOG_LEVEL=INFO

# Database (relative to /app inside the container -> ./data on the host)
DATABASE_URL=sqlite:///data/troubleshooter.db

# OpenPLC
OPENPLC_HOST=openplc
OPENPLC_PORT=502
OPENPLC_WEB_PORT=8080

# Modbus
MODBUS_TIMEOUT=3
MODBUS_RETRY_COUNT=3

# Serial / RTU (only used when protocol=rtu)
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUDRATE=9600

# Security — CHANGE THIS before any non-test deployment
SECRET_KEY=change-me-run-openssl-rand-hex-32

# Grafana admin password
GRAFANA_PASSWORD=admin
